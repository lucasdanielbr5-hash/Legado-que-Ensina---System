<form id="cadastroForm" onsubmit="validarAcesso(event)">
  <!-- Caixa de seleção dos Termos -->
  <div style="margin: 20px 0; font-family: sans-serif; font-size: 14px; color: #333; line-height: 1.5;">
    <input type="checkbox" id="aceiteTermos" name="aceiteTermos" required style="cursor: pointer; transform: scale(1.2); margin-right: 10px; vertical-align: middle;">
    <label for="aceiteTermos" style="cursor: pointer; vertical-align: middle;">
      Li, compreendi e aceito integralmente os 
      <a href="termos_de_uso_sistema_psicopedagogico.pdf" target="_blank" style="color: #1a4a6e; font-weight: bold; text-decoration: underline;">
        Termos e Condições de Uso
      </a> 
      do sistema Legado que Ensina.
    </label>
  </div>

  <!-- Botão de Entrar/Cadastrar -->
  <button type="submit" id="btnEnviar" style="background-color: #1a4a6e; color: white; border: none; padding: 12px 24px; font-size: 16px; font-weight: bold; border-radius: 4px; cursor: pointer; width: 100%;">
    Acessar Sistema
  </button>
</form>

<script>
  // Script simples para garantir que ele marcou a caixa antes de prosseguir
  function validarAcesso(event) {
    const checkbox = document.getElementById('aceiteTermos');
    if (!checkbox.checked) {
      event.preventDefault();
      alert('Você precisa ler e aceitar os Termos de Uso para acessar o sistema.');
      return false;
    }
    // Caso esteja marcado, o sistema segue o fluxo normal
    return true;
  }
</script> 
